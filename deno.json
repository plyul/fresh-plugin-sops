{
  "tasks": {
    "types": "mkdir -p types && cp \"$(fresh --cmd script types | head -n 1)\" types/fresh.d.ts",
    "check": "deno check lib/ tests/ sops.ts",
    "test": "deno test --allow-read=. tests/",
    "e2e": "bash tests/e2e/run.sh"
  },
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2
  },
  "exclude": [
    "types/",
    "tests/fixtures/"
  ]
}
